diff --git a/tests/video-sync.test.mjs b/tests/video-sync.test.mjs
new file mode 100644
index 0000000..ae2b817
--- /dev/null
+++ b/tests/video-sync.test.mjs
@@ -0,0 +1,19 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { followStep } from "../.test-build/videoSync.mjs";
+
+const audio = (time, extra = {}) => ({ time, rate: 1, playing: true, buffering: false, ...extra });
+
+test("the picture follows the sound: paused or buffering audio pauses it, and it re-aligns when off", () => {
+  assert.deepEqual(followStep({ currentTime: 10, paused: false }, audio(10, { playing: false })), { play: false, rate: 1 });
+  assert.deepEqual(followStep({ currentTime: 12, paused: false }, audio(10, { buffering: true })), { play: false, rate: 1, seekTo: 10 });
+});
+
+test("far off it jumps a little ahead; close it eases back by at most 5%; in step it matches the speed", () => {
+  assert.deepEqual(followStep({ currentTime: 5, paused: false }, audio(10)), { play: true, rate: 1, seekTo: 10.2 });
+  const ahead = followStep({ currentTime: 10.3, paused: false }, audio(10));
+  assert.ok(ahead.rate < 1 && ahead.rate >= 0.95, "ahead: slows down");
+  const behind = followStep({ currentTime: 9.4, paused: false }, audio(10));
+  assert.ok(behind.rate > 1 && behind.rate <= 1.05, "behind: speeds up, capped");
+  assert.deepEqual(followStep({ currentTime: 10.01, paused: false }, audio(10, { rate: 1.5 })), { play: true, rate: 1.5 });
+});

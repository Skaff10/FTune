diff --git a/src/lib/videoSync.ts b/src/lib/videoSync.ts
new file mode 100644
index 0000000..258f3b6
--- /dev/null
+++ b/src/lib/videoSync.ts
@@ -0,0 +1,19 @@
+/**
+ * Keeps a muted music video in step with the audio, the master clock: the
+ * picture follows and never holds the sound back. Called a few times a
+ * second; says what to do with the video element.
+ */
+export function followStep(
+  video: { currentTime: number; paused: boolean },
+  audio: { time: number; rate: number; playing: boolean; buffering: boolean }
+): { seekTo?: number; rate: number; play: boolean } {
+  const drift = video.currentTime - audio.time; // > 0: the picture is ahead
+  if (!audio.playing || audio.buffering) {
+    return { play: false, rate: audio.rate, ...(Math.abs(drift) > 0.25 ? { seekTo: audio.time } : {}) };
+  }
+  // Far off: jump, a little ahead, since decoding from a keyframe takes a moment.
+  if (Math.abs(drift) > 0.8) return { play: true, rate: audio.rate, seekTo: audio.time + 0.2 };
+  // Close: ease back with a rate change of at most ±5%, which nobody sees.
+  if (Math.abs(drift) > 0.04) return { play: true, rate: audio.rate * (1 - Math.max(-0.5, Math.min(0.5, drift)) * 0.1) };
+  return { play: true, rate: audio.rate };
+}

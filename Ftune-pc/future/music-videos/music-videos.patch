+/* ---------------- a song's music video ---------------- */
+
+/**
+ * The official music video for a catalogue song, out of Videos search rows:
+ * the same title once "(Official Video)" and "ft." credits are gone (or
+ * "Artist - Title"), the same first artist, and a plausible length — videos
+ * often run longer, with an intro or a skit. YouTube Music links the two
+ * versions only for signed-in listeners, which ByTune never is.
+ */
+export function pickMusicVideo(song: Track, rows: SearchRow[]): Track | null {
+  const name = normalizeTitle(song.title);
+  const who = artistKey(song.artist);
+  if (!name || !who) return null;
+  for (const row of rows.slice(0, 6)) {
+    if (row.kind === "browse") continue;
+    const v = row.song;
+    if (v.id === song.id) continue;
+    const title = normalizeTitle(v.title);
+    if (title !== name && title !== `${who} ${name}`) continue;
+    if (artistKey(v.artist) !== who && !normalizeTitle(v.artist).includes(who)) continue;
+    if (song.duration > 0 && v.duration > 0 && (v.duration < song.duration - 10 || v.duration > song.duration + 240)) continue;
+    return v;
+  }
+  return null;
+}
